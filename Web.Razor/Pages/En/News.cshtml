@page
@model Web.Razor.Pages.En.NewsModel

@{
    ViewData["Title"] = "News";
}

<section class="mq-container mt-space fade-in">
    @await Html.PartialAsync("_PanelShell", new Web.Razor.Pages.Shared.PanelShellModel { Title = (string)ViewData["ServerName"] + " News", Description = "Announcements from the team.", AdditionalClasses = "panel-p-lg panel-variant-success" })
        <div class="row">
            <div class="col-12" data-reveal>
                <article class="flow" style="max-width:760px;">
                    <h3 class="t-sub" style="color:var(--mq-color-text);">Latest</h3>
                    <p>Nothing to announce yet. For the latest game updates, see the <a href="/changelog">changelog</a>.</p>
                </article>
            </div>
        </div>
    </div>
</section>
