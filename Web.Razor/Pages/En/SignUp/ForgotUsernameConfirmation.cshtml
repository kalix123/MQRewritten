@page
@model Web.Razor.Pages.En.SignUp.ForgotUsernameConfirmationModel

@{
    ViewData["Title"] = "Check Your Email";
}

<section class="mq-container mt-space fade-in">
    @await Html.PartialAsync("_PanelShell", new Web.Razor.Pages.Shared.PanelShellModel { Title = "Check Your Email", Description = "If an account uses that email address, we've sent its username there.", CenterHeader = true, AdditionalClasses = "panel-p-lg flow" })
        <img class="site_logo" src="/_content/Web.Razor/logo.png" alt="Site Logo" style="max-width:120px;" data-reveal />
        <div class="action-row mt-1_5" data-reveal>
            <a href="/en/login" class="btn-modern btn-accent btn-pad-md">Back to Login</a>
        </div>
    </div>
</section>